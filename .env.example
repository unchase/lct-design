# Copy to .env; never commit credentials. Local Docker loads this file.
# Empty token is allowed only for the localhost-only development compose.
# Public compose requires a nonempty token. HTTP Basic login: forma.
LCT_ACCESS_TOKEN=
# Leave empty locally. Public compose sets this from LCT_DOMAIN automatically
# so browser request origins are checked against the external HTTPS address.
LCT_PUBLIC_URL=

# Production: existing Traefik proxy and container registry.
REGISTRY_HOST=registry.inflake.fun
FORMA_TAG=main
LCT_DOMAIN=forma.inflake.fun
LCT_PROXY_NETWORK=intranet
LCT_TLS_RESOLVER=leresolver
# Set true only when existing Watchtower should automatically replace this app.
LCT_WATCHTOWER_ENABLED=false

# OpenAI-compatible inference, configured in the UI or by environment.
# Preset: OpenRouter with the model named in the task (Qwen3.8-27B, open
# weights, Apache-2.0, 27.8B parameters; accepts text and images, so it also
# serves the visual audit). AI stays off until LCT_API_KEY is set.
# Custom provider: replace LCT_API_BASE with its base URL (usually ending /v1)
# and the model IDs with that provider's exact IDs.
# Persisted UI settings take precedence. Keys stay on the server under /data.
LCT_API_BASE=https://openrouter.ai/api/v1
LCT_API_KEY=
LCT_MODEL=qwen/qwen3.8-27b
LCT_COMPETITION_MODE=true
LCT_MODEL_LICENSE=Apache-2.0
LCT_MODEL_PARAMETERS_B=27.8
LCT_MODEL_CARD=https://huggingface.co/Qwen/Qwen3.8-27B
LCT_VISION_ENABLED=true
LCT_VISION_MODEL=qwen/qwen3.8-27b
LCT_VISION_LICENSE=Apache-2.0
LCT_VISION_PARAMETERS_B=27.8
LCT_VISION_CARD=https://huggingface.co/Qwen/Qwen3.8-27B
# Qwen3-class models think before answering and can exhaust the token budget;
# true sends reasoning off (OpenRouter) or enable_thinking=false (vLLM/SGLang).
LCT_DISABLE_REASONING=true

# Host mode defaults to isolated Docker renderer; compose uses local LibreOffice.
LCT_RENDER_IMAGE=lct-design-renderer:local
